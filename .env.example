# Copy to .env. `render workflows dev` loads .env into the task server.
# treg team token (optional locally if the treg CLI is signed in)
TREG_TOKEN=
# Leave empty to store runs as JSON files in ./runs
DATABASE_URL=
# OpenRouter engines (or_openai, or_gemini, or_perplexity)
OPENROUTER_API_KEY=
# claude_api engine
ANTHROPIC_API_KEY=
